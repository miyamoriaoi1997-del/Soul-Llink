diff --git a/tests/agent/test_soullink_memory_authority_adapter.py b/tests/agent/test_soullink_memory_authority_adapter.py
new file mode 100644
index 00000000..bc26587a
--- /dev/null
+++ b/tests/agent/test_soullink_memory_authority_adapter.py
@@ -0,0 +1,103 @@
+from __future__ import annotations
+
+import json
+from types import SimpleNamespace
+
+from agent.agent_runtime_helpers import invoke_tool
+from agent.soullink_memory_authority import (
+    filter_tool_definitions,
+    forbidden_result,
+    state_for_agent,
+    state_for_config,
+)
+
+
+def _defs(*names: str) -> list[dict]:
+    return [
+        {"type": "function", "function": {"name": name, "parameters": {"type": "object"}}}
+        for name in names
+    ]
+
+
+def test_schema_hides_builtin_memory_but_keeps_soullink_tools() -> None:
+    names = {
+        item["function"]["name"]
+        for item in filter_tool_definitions(
+            _defs("memory", "session_search", "soullink_memory_search", "soullink_memory_remember"),
+            config={"memory": {"provider": "soullink"}},
+        )
+    }
+    assert names == {"soullink_memory_search", "soullink_memory_remember"}
+
+
+def test_non_soullink_provider_is_unchanged() -> None:
+    original = _defs("memory", "session_search", "mem0_search")
+    assert filter_tool_definitions(
+        original,
+        config={"memory": {"provider": "mem0"}},
+    ) is original
+    assert forbidden_result("memory", state="inactive") is None
+
+
+def test_configured_but_unavailable_fails_closed() -> None:
+    assert state_for_config(
+        {"memory": {"provider": "soullink"}},
+        provider_available=False,
+    ) == "unavailable"
+    result = json.loads(forbidden_result("memory", state="unavailable"))
+    assert result == {
+        "success": False,
+        "status": "unavailable",
+        "authority": "soullink/pcltm",
+        "fallback": "forbidden",
+        "tool": "memory",
+    }
+
+
+def test_sequential_and_concurrent_dispatch_gate_blocks_retired_tools() -> None:
+    import ast
+    from pathlib import Path
+
+    source = Path("agent/tool_executor.py").read_text(encoding="utf-8")
+    tree = ast.parse(source)
+    calls = [
+        node
+        for node in ast.walk(tree)
+        if isinstance(node, ast.Call)
+        and isinstance(node.func, ast.Name)
+        and node.func.id == "_memory_authority_block_for_agent"
+    ]
+    assert len(calls) == 2
+    assert "execute_tool_calls_concurrent" in source
+    assert "execute_tool_calls_sequential" in source
+
+
+def test_runtime_helper_blocks_direct_memory_without_touching_store() -> None:
+    class ExplodingStore:
+        def __getattribute__(self, name):
+            raise AssertionError(f"built-in store touched: {name}")
+
+    agent = SimpleNamespace(
+        _soullink_memory_authority_state="active",
+        _memory_store=ExplodingStore(),
+        _memory_manager=None,
+    )
+    result = json.loads(invoke_tool(agent, "memory", {"action": "add"}, "task"))
+    assert result["status"] == "forbidden"
+    assert result["fallback"] == "forbidden"
+
+
+def test_runtime_helper_blocks_session_search_without_db_recall() -> None:
+    agent = SimpleNamespace(
+        _soullink_memory_authority_state="active",
+        _get_session_db_for_recall=lambda: (_ for _ in ()).throw(
+            AssertionError("session DB recall must not run")
+        ),
+    )
+    result = json.loads(invoke_tool(agent, "session_search", {"query": "x"}, "task"))
+    assert result["status"] == "forbidden"
+    assert result["fallback"] == "forbidden"
+
+
+def test_invalid_agent_state_is_inactive() -> None:
+    assert state_for_agent(SimpleNamespace(_soullink_memory_authority_state="bogus")) == "inactive"
