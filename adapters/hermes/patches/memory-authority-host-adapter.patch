diff --git a/tests/agent/test_exclusive_memory_authority_contract.py b/tests/agent/test_exclusive_memory_authority_contract.py
new file mode 100644
index 00000000..ac7bfc91
--- /dev/null
+++ b/tests/agent/test_exclusive_memory_authority_contract.py
@@ -0,0 +1,115 @@
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from agent.memory_authority import (
+    authority_policy_for_config,
+    builtin_memory_flags,
+    filter_tool_definitions,
+    forbidden_result_for_agent,
+    set_authority_state,
+)
+
+
+def _exclusive_plugin(tmp_path: Path, name: str = "canonical") -> Path:
+    plugin = tmp_path / "plugins" / name
+    plugin.mkdir(parents=True)
+    (plugin / "__init__.py").write_text(
+        "def register_memory_provider():\n    raise AssertionError('policy lookup must not import provider')\n",
+        encoding="utf-8",
+    )
+    (plugin / "plugin.yaml").write_text(
+        "manifest_version: 1\n"
+        f"name: {name}\n"
+        "kind: exclusive\n"
+        "authority: Canonical Test Store\n"
+        "blocked_host_tools:\n"
+        "  - memory\n"
+        "  - session_search\n",
+        encoding="utf-8",
+    )
+    return plugin
+
+
+def _config(name: str = "canonical") -> dict:
+    return {
+        "memory": {
+            "provider": name,
+            "memory_enabled": True,
+            "user_profile_enabled": True,
+        }
+    }
+
+
+def test_exclusive_policy_is_manifest_driven_without_importing_provider(tmp_path, monkeypatch):
+    _exclusive_plugin(tmp_path)
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+
+    policy = authority_policy_for_config(_config())
+
+    assert policy.exclusive is True
+    assert policy.provider_name == "canonical"
+    assert policy.authority == "Canonical Test Store"
+    assert policy.blocked_tools == frozenset({"memory", "session_search"})
+    assert builtin_memory_flags(_config()) == (False, False)
+
+
+def test_nonexclusive_provider_preserves_builtin_flags(tmp_path, monkeypatch):
+    plugin = _exclusive_plugin(tmp_path, "additive")
+    (plugin / "plugin.yaml").write_text(
+        "manifest_version: 1\nname: additive\nkind: standalone\n",
+        encoding="utf-8",
+    )
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+
+    assert authority_policy_for_config(_config("additive")).exclusive is False
+    assert builtin_memory_flags(_config("additive")) == (True, True)
+
+
+@pytest.mark.parametrize("provider_available,state", [(False, "unavailable"), (True, "active")])
+def test_exclusive_state_fails_closed_when_provider_is_unavailable(
+    tmp_path, monkeypatch, provider_available, state
+):
+    _exclusive_plugin(tmp_path)
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    agent = SimpleNamespace()
+
+    set_authority_state(agent, _config(), provider_available=provider_available)
+
+    assert agent._memory_authority_state == state
+    result = json.loads(forbidden_result_for_agent(agent, "memory"))
+    assert result == {
+        "success": False,
+        "status": "forbidden" if provider_available else "unavailable",
+        "authority": "Canonical Test Store",
+        "provider": "canonical",
+        "fallback": "forbidden",
+        "tool": "memory",
+    }
+
+
+def test_exclusive_schema_filter_is_generic(tmp_path, monkeypatch):
+    _exclusive_plugin(tmp_path)
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    definitions = [
+        {"type": "function", "function": {"name": "memory"}},
+        {"type": "function", "function": {"name": "session_search"}},
+        {"type": "function", "function": {"name": "terminal"}},
+    ]
+
+    assert [
+        item["function"]["name"]
+        for item in filter_tool_definitions(definitions, config=_config())
+    ] == ["terminal"]
+
+
+def test_missing_exclusive_plugin_manifest_does_not_guess_from_provider_name(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    config = _config("soullink")
+
+    assert authority_policy_for_config(config).exclusive is False
+    assert builtin_memory_flags(config) == (True, True)
