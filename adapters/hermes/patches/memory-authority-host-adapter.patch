@@ -0,0 +1,57 @@
+from __future__ import annotations
+
+import json
+from collections.abc import Mapping
+from typing import Any
+
+BLOCKED_TOOLS = frozenset({"memory", "session_search"})
+
+
+def configured_provider(config: Mapping[str, Any] | None) -> str | None:
+    if not isinstance(config, Mapping):
+        return None
+    memory = config.get("memory")
+    provider = memory.get("provider") if isinstance(memory, Mapping) else None
+    if not isinstance(provider, str) or not provider.strip():
+        return None
+    return provider.strip().lower()
+
+
+def state_for_config(config: Mapping[str, Any] | None, *, provider_available: bool) -> str:
+    if configured_provider(config) != "soullink":
+        return "inactive"
+    return "active" if provider_available else "unavailable"
+
+
+def state_for_agent(agent: Any) -> str:
+    state = getattr(agent, "_soullink_memory_authority_state", "inactive")
+    return state if state in {"active", "unavailable"} else "inactive"
+
+
+def filter_tool_definitions(
+    tool_definitions: list[dict[str, Any]],
+    *,
+    config: Mapping[str, Any] | None,
+) -> list[dict[str, Any]]:
+    if configured_provider(config) != "soullink":
+        return tool_definitions
+    return [
+        definition
+        for definition in tool_definitions
+        if definition.get("function", {}).get("name") not in BLOCKED_TOOLS
+    ]
+
+
+def forbidden_result(tool_name: str, *, state: str) -> str | None:
+    if tool_name not in BLOCKED_TOOLS or state not in {"active", "unavailable"}:
+        return None
+    return json.dumps(
+        {
+            "success": False,
+            "status": "unavailable" if state == "unavailable" else "forbidden",
+            "authority": "soullink/pcltm",
+            "fallback": "forbidden",
+            "tool": tool_name,
+        },
+        ensure_ascii=False,
+    )
