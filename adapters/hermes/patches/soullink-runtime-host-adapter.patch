+from __future__ import annotations
+
+import json
+from types import SimpleNamespace
+
+from agent.agent_runtime_helpers import invoke_tool
+from agent.memory_authority import (
+    MemoryAuthorityPolicy,
+    builtin_memory_flags,
+    filter_tool_definitions,
+    forbidden_result_for_agent,
+    state_for_agent,
+)
+
+
+_POLICY = MemoryAuthorityPolicy(
+    provider_name="soullink",
+    authority="soullink/pcltm",
+    exclusive=True,
+    blocked_tools=frozenset({"memory", "session_search"}),
+)
+
+
+def _agent(**kwargs):
+    return SimpleNamespace(
+        _memory_authority_policy=_POLICY,
+        _memory_authority_state="active",
+        **kwargs,
+    )
+
+
+def test_schema_hides_builtin_memory_but_keeps_soullink_tools(monkeypatch, tmp_path) -> None:
+    plugin = tmp_path / "plugins" / "soullink"
+    plugin.mkdir(parents=True)
+    (plugin / "__init__.py").write_text("def register_memory_provider(): pass\n")
+    (plugin / "plugin.yaml").write_text(
+        "name: soullink\nkind: exclusive\nauthority: soullink/pcltm\n"
+        "blocked_host_tools: [memory, session_search]\n"
+    )
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    definitions = [
+        {"type": "function", "function": {"name": "memory"}},
+        {"type": "function", "function": {"name": "session_search"}},
+        {"type": "function", "function": {"name": "soullink_memory_search"}},
+    ]
+    names = [
+        item["function"]["name"]
+        for item in filter_tool_definitions(
+            definitions,
+            config={"memory": {"provider": "soullink"}},
+        )
+    ]
+    assert names == ["soullink_memory_search"]
+
+
+def test_soullink_forces_builtin_memory_and_user_profile_off(monkeypatch, tmp_path) -> None:
+    plugin = tmp_path / "plugins" / "soullink"
+    plugin.mkdir(parents=True)
+    (plugin / "__init__.py").write_text("def register_memory_provider(): pass\n")
+    (plugin / "plugin.yaml").write_text("name: soullink\nkind: exclusive\n")
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    assert builtin_memory_flags(
+        {
+            "memory": {
+                "provider": "soullink",
+                "memory_enabled": True,
+                "user_profile_enabled": True,
+            }
+        }
+    ) == (False, False)
+
+
+def test_runtime_helper_blocks_direct_memory_without_touching_store() -> None:
+    class ExplodingStore:
+        def __getattribute__(self, name):
+            raise AssertionError(f"built-in store touched: {name}")
+
+    result = json.loads(
+        invoke_tool(
+            _agent(_memory_store=ExplodingStore(), _memory_manager=None),
+            "memory",
+            {"action": "add"},
+            "task",
+        )
+    )
+    assert result["status"] == "forbidden"
+    assert result["fallback"] == "forbidden"
+
+
+def test_runtime_helper_blocks_session_search_without_db_recall() -> None:
+    agent = _agent(
+        _get_session_db_for_recall=lambda: (_ for _ in ()).throw(
+            AssertionError("session DB recall must not run")
+        )
+    )
+    result = json.loads(invoke_tool(agent, "session_search", {"query": "x"}, "task"))
+    assert result["status"] == "forbidden"
+    assert result["fallback"] == "forbidden"
+
+
+def test_unavailable_authority_never_falls_back() -> None:
+    agent = _agent()
+    agent._memory_authority_state = "unavailable"
+    result = json.loads(forbidden_result_for_agent(agent, "memory"))
+    assert result["status"] == "unavailable"
+    assert result["fallback"] == "forbidden"
+
+
+def test_invalid_agent_state_is_inactive() -> None:
+    assert state_for_agent(SimpleNamespace(_memory_authority_state="bogus")) == "inactive"
