@@ -0,0 +1,75 @@
+"""Regression contract for the final pre-model memory observer seam."""
+
+from __future__ import annotations
+
+import ast
+from pathlib import Path
+from unittest.mock import MagicMock
+
+from agent.memory_manager import MemoryManager
+from agent.memory_provider import MemoryProvider
+
+
+class ObservingProvider(MemoryProvider):
+    def __init__(self, name: str = "observer") -> None:
+        self._name = name
+
+    @property
+    def name(self) -> str:
+        return self._name
+
+    def is_available(self) -> bool:
+        return True
+
+    def initialize(self, session_id: str, **kwargs) -> None:
+        return None
+
+    def sync_turn(self, user_content: str, assistant_content: str, **kwargs) -> None:
+        return None
+
+    def get_tool_schemas(self):
+        return []
+
+    def handle_tool_call(self, tool_name, args, **kwargs):
+        return "{}"
+
+
+def test_memory_manager_final_forward_observer_fans_out_and_contains_failures():
+    manager = MemoryManager()
+    broken = ObservingProvider("builtin")
+    broken.on_before_model_forward = MagicMock(side_effect=RuntimeError("boom"))
+    observed = ObservingProvider("observer")
+    observed.on_before_model_forward = MagicMock()
+    manager.add_provider(broken)
+    manager.add_provider(observed)
+    final_messages = [{"role": "user", "content": "final outbound"}]
+
+    manager.on_before_model_forward(final_messages)
+
+    broken.on_before_model_forward.assert_called_once_with(final_messages)
+    observed.on_before_model_forward.assert_called_once_with(final_messages)
+
+
+def test_conversation_loop_observes_after_execution_middleware_at_final_forward_boundary():
+    source = Path(__file__).parents[2] / "agent" / "conversation_loop.py"
+    text = source.read_text(encoding="utf-8")
+    tree = ast.parse(text)
+    calls = [
+        node
+        for node in ast.walk(tree)
+        if isinstance(node, ast.Call)
+        and isinstance(node.func, ast.Attribute)
+        and node.func.attr == "on_before_model_forward"
+    ]
+    assert calls, "final host request never notifies memory observers"
+    observer_line = min(node.lineno for node in calls)
+
+    final_forward = next(
+        node
+        for node in ast.walk(tree)
+        if isinstance(node, ast.FunctionDef) and node.name == "_perform_api_call"
+    )
+    assert final_forward.lineno < observer_line < final_forward.end_lineno
+    observer_offset = text.index("on_before_model_forward")
+    assert text.index("preflight_kwargs", observer_offset - 1200) < observer_offset
+    assert observer_offset < text.index("_interruptible_streaming_api_call", observer_offset)
diff --git a/agent/memory_authority.py b/agent/memory_authority.py
new file mode 100644
index 000000000..11581122a
--- /dev/null
+++ b/agent/memory_authority.py
@@ -0,0 +1,146 @@
+"""Generic exclusive-memory authority policy for external providers.
+
+The policy is read from a provider's ``plugin.yaml`` without importing plugin
+code.  This lets the host fail closed when a configured canonical authority is
+missing dependencies or cannot initialize: host memory never becomes an
+implicit fallback merely because the external provider is unavailable.
+"""
+
+from __future__ import annotations
+
+import json
+from collections.abc import Mapping
+from dataclasses import dataclass
+from typing import Any
+
+
+_DEFAULT_BLOCKED_HOST_TOOLS = frozenset({"memory", "session_search"})
+_VALID_STATES = frozenset({"active", "unavailable", "inactive"})
+
+
+@dataclass(frozen=True)
+class MemoryAuthorityPolicy:
+    provider_name: str | None = None
+    authority: str | None = None
+    exclusive: bool = False
+    blocked_tools: frozenset[str] = frozenset()
+
+
+def configured_provider(config: Mapping[str, Any] | None) -> str | None:
+    if not isinstance(config, Mapping):
+        return None
+    memory = config.get("memory")
+    provider = memory.get("provider") if isinstance(memory, Mapping) else None
+    if not isinstance(provider, str) or not provider.strip():
+        return None
+    return provider.strip().lower()
+
+
+def authority_policy_for_config(
+    config: Mapping[str, Any] | None,
+) -> MemoryAuthorityPolicy:
+    provider_name = configured_provider(config)
+    if provider_name is None:
+        return MemoryAuthorityPolicy()
+
+    try:
+        from plugins.memory import find_provider_dir
+
+        provider_dir = find_provider_dir(provider_name)
+        manifest_file = provider_dir / "plugin.yaml" if provider_dir else None
+        if manifest_file is None or not manifest_file.is_file():
+            return MemoryAuthorityPolicy(provider_name=provider_name)
+        import yaml
+
+        manifest = yaml.safe_load(manifest_file.read_text(encoding="utf-8-sig")) or {}
+    except Exception:
+        return MemoryAuthorityPolicy(provider_name=provider_name)
+
+    if not isinstance(manifest, Mapping) or str(manifest.get("kind", "")).lower() != "exclusive":
+        return MemoryAuthorityPolicy(provider_name=provider_name)
+
+    raw_blocked = manifest.get("blocked_host_tools", _DEFAULT_BLOCKED_HOST_TOOLS)
+    if isinstance(raw_blocked, (list, tuple, set, frozenset)):
+        blocked = frozenset(
+            str(name).strip() for name in raw_blocked if str(name).strip()
+        )
+    else:
+        blocked = _DEFAULT_BLOCKED_HOST_TOOLS
+    authority = str(manifest.get("authority") or provider_name).strip()
+    return MemoryAuthorityPolicy(
+        provider_name=provider_name,
+        authority=authority,
+        exclusive=True,
+        blocked_tools=blocked,
+    )
+
+
+def builtin_memory_flags(
+    config: Mapping[str, Any] | None,
+) -> tuple[bool, bool]:
+    if authority_policy_for_config(config).exclusive:
+        return False, False
+    memory = config.get("memory") if isinstance(config, Mapping) else None
+    if not isinstance(memory, Mapping):
+        return False, False
+    return bool(memory.get("memory_enabled", False)), bool(
+        memory.get("user_profile_enabled", False)
+    )
+
+
+def set_authority_state(
+    agent: Any,
+    config: Mapping[str, Any] | None,
+    *,
+    provider_available: bool,
+) -> str:
+    policy = authority_policy_for_config(config)
+    state = (
+        "active" if provider_available else "unavailable"
+    ) if policy.exclusive else "inactive"
+    agent._memory_authority_policy = policy
+    agent._memory_authority_state = state
+    return state
+
+
+def state_for_agent(agent: Any) -> str:
+    state = getattr(agent, "_memory_authority_state", "inactive")
+    return state if state in _VALID_STATES else "inactive"
+
+
+def filter_tool_definitions(
+    tool_definitions: list[dict[str, Any]],
+    *,
+    config: Mapping[str, Any] | None,
+) -> list[dict[str, Any]]:
+    policy = authority_policy_for_config(config)
+    if not policy.exclusive:
+        return tool_definitions
+    return [
+        definition
+        for definition in tool_definitions
+        if definition.get("function", {}).get("name") not in policy.blocked_tools
+    ]
+
+
+def forbidden_result_for_agent(agent: Any, tool_name: str) -> str | None:
+    policy = getattr(agent, "_memory_authority_policy", MemoryAuthorityPolicy())
+    state = state_for_agent(agent)
+    if (
+        not isinstance(policy, MemoryAuthorityPolicy)
+        or not policy.exclusive
+        or tool_name not in policy.blocked_tools
+        or state not in {"active", "unavailable"}
+    ):
+        return None
+    return json.dumps(
+        {
+            "success": False,
+            "status": "unavailable" if state == "unavailable" else "forbidden",
+            "authority": policy.authority,
+            "provider": policy.provider_name,
+            "fallback": "forbidden",
+            "tool": tool_name,
+        },
+        ensure_ascii=False,
+    )
