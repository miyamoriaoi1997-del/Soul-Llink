+def _top_level_subsystems(paths: list[str], root: str | None) -> set[str]:
+    """Return changed top-level directories that are inside the project root."""
+    if not root:
+        return set()
+    try:
+        root_path = Path(root).resolve()
+    except Exception:
+        return set()
+    subsystems: set[str] = set()
+    for raw in paths:
+        try:
+            relative = Path(raw).resolve().relative_to(root_path)
+        except (OSError, ValueError):
+            continue
+        if len(relative.parts) > 1:
+            subsystems.add(relative.parts[0])
+    return subsystems
+
+
+def _verification_scope_instruction(paths: list[str], facts: dict[str, Any]) -> str:
+    """Recommend the least costly check justified by the edit's blast radius."""
+    subsystems = _top_level_subsystems(paths, str(facts.get("root") or ""))
+    if len(subsystems) >= 3:
+        return (
+            "This edit crosses multiple top-level subsystems, so broader verification "
+            "is recommended after focused checks pass."
+        )
+    return (
+        "Prefer the smallest focused check that exercises the changed behavior. "
+        "A passing targeted test is sufficient for this gate when it covers the final "
+        "edit. Do not run the full suite solely to satisfy this gate."
+    )
+
