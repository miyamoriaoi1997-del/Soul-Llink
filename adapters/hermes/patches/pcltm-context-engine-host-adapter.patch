diff --git a/tests/agent/test_context_request_budget.py b/tests/agent/test_context_request_budget.py
new file mode 100644
index 000000000..4909a95f8
--- /dev/null
+++ b/tests/agent/test_context_request_budget.py
@@ -0,0 +1,103 @@
+"""Tests for host-accounted context request budgets and capability negotiation."""
+
+from types import SimpleNamespace
+
+import pytest
+
+from agent.conversation_compression import _compress_kwargs, build_context_request_budget
+
+
+def test_context_budget_uses_cached_prompt_and_actual_max_tokens():
+    agent = SimpleNamespace(
+        context_compressor=SimpleNamespace(
+            _configured_budget_tokens=128_000,
+            _request_budget_safety_margin_tokens=4_096,
+        ),
+        tools=[{"type": "function", "function": {"name": "demo", "description": "x" * 400}}],
+        _cached_system_prompt="cached" * 1000,
+        max_tokens=12_345,
+    )
+
+    budget = build_context_request_budget(agent, system_prompt="wrong")
+
+    assert budget["total_budget_tokens"] == 128_000
+    assert budget["system_prompt_budget_tokens"] == len(agent._cached_system_prompt) // 4
+    assert budget["memory_prompt_budget_tokens"] == 0
+    assert budget["response_budget_tokens"] == 12_345
+    assert budget["tool_schema_budget_tokens"] > 0
+    assert sum(
+        budget[key]
+        for key in (
+            "message_budget_tokens",
+            "system_prompt_budget_tokens",
+            "tool_schema_budget_tokens",
+            "memory_prompt_budget_tokens",
+            "response_budget_tokens",
+        )
+    ) == budget["total_budget_tokens"] - 4_096
+
+
+def test_context_budget_builds_full_prompt_when_cache_is_empty():
+    agent = SimpleNamespace(
+        context_compressor=SimpleNamespace(
+            _configured_budget_tokens=10_000,
+            _request_budget_safety_margin_tokens=512,
+        ),
+        tools=[],
+        _cached_system_prompt=None,
+        _build_system_prompt=lambda extra: "identity-memory-skills:" + extra,
+        max_tokens=1_024,
+    )
+    budget = build_context_request_budget(agent, system_prompt="extra")
+    assert budget["system_prompt_budget_tokens"] == (
+        len("identity-memory-skills:extra") + 3
+    ) // 4
+
+
+def test_context_budget_rejects_impossible_fixed_buckets():
+    agent = SimpleNamespace(
+        context_compressor=SimpleNamespace(
+            _configured_budget_tokens=2_000,
+            _request_budget_safety_margin_tokens=512,
+        ),
+        tools=[],
+        _cached_system_prompt="x" * 4_000,
+        max_tokens=1_024,
+    )
+    with pytest.raises(ValueError, match="cannot fit"):
+        build_context_request_budget(agent)
+
+
+def test_context_request_budget_empty_without_single_budget():
+    agent = SimpleNamespace(context_compressor=SimpleNamespace(_configured_budget_tokens=0), tools=[])
+    assert build_context_request_budget(agent, system_prompt="system") == {}
+
+
+def test_compress_kwargs_preserves_supported_legacy_parameters():
+    class LegacyEngine:
+        def compress(self, messages, current_tokens=None, focus_topic=None, force=False):
+            return messages
+
+    kwargs = _compress_kwargs(
+        LegacyEngine(), current_tokens=10, focus_topic="topic", force=True,
+        request_budget={"total_budget_tokens": 100},
+    )
+    assert kwargs == {"current_tokens": 10, "focus_topic": "topic", "force": True}
+
+
+def test_internal_type_error_is_not_used_as_signature_probe():
+    calls = []
+
+    class Engine:
+        def compress(self, messages, current_tokens=None, **kwargs):
+            calls.append(1)
+            raise TypeError("implementation bug")
+
+    engine = Engine()
+    kwargs = _compress_kwargs(
+        engine, current_tokens=10, focus_topic="topic", force=True,
+        request_budget={"total_budget_tokens": 100},
+    )
+    with pytest.raises(TypeError, match="implementation bug"):
+        engine.compress([], **kwargs)
+    assert calls == [1]
