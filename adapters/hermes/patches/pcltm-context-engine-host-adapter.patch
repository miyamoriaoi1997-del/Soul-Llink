 from agent.model_metadata import estimate_request_tokens_rough
 
+
+def build_context_request_budget(agent: Any, system_prompt: str = "") -> dict[str, int]:
+    """Account for the actual stable request buckets under one total budget."""
+    engine = getattr(agent, "context_compressor", None)
+    budget = int(getattr(engine, "_configured_budget_tokens", 0) or 0)
+    if budget <= 0:
+        return {}
+    safety_margin = int(getattr(engine, "_request_budget_safety_margin_tokens", 512) or 0)
+    # Compression normally runs after the session prompt was built. Prefer that
+    # exact cached prompt; only build it when no stable prompt exists yet.
+    actual_system_prompt = getattr(agent, "_cached_system_prompt", None)
+    if not actual_system_prompt:
+        builder = getattr(agent, "_build_system_prompt", None)
+        actual_system_prompt = (
+            builder(system_prompt or "")
+            if callable(builder)
+            else (system_prompt or "")
+        )
+    system_budget = (len(actual_system_prompt or "") + 3) // 4
+    tools = getattr(agent, "tools", None) or []
+    tool_schema_budget = estimate_request_tokens_rough([], tools=tools)
+    configured_response = getattr(agent, "max_tokens", None)
+    response_budget = int(configured_response) if configured_response else max(1024, int(budget * 0.05))
+    fixed = safety_margin + response_budget + system_budget + tool_schema_budget
+    if fixed + 256 > budget:
+        raise ValueError(
+            "context.budget_tokens cannot fit the system prompt, tool schemas, "
+            "response max_tokens, safety margin, and minimum message budget"
+        )
+    active_frame_budget = budget - fixed
+    return {
+        "total_budget_tokens": budget,
+        "message_budget_tokens": active_frame_budget,
+        "system_prompt_budget_tokens": system_budget,
+        "tool_schema_budget_tokens": tool_schema_budget,
+        # Memory/persona injection is already part of the exact system prompt.
+        "memory_prompt_budget_tokens": 0,
+        "response_budget_tokens": response_budget,
+    }
+
+
+def _compress_kwargs(compressor: Any, **candidates: Any) -> dict[str, Any]:
+    """Select supported kwargs without executing the compressor as a probe."""
+    try:
+        signature = inspect.signature(compressor.compress)
+    except (TypeError, ValueError):
+        # Unknown callables get only the long-standing required token argument.
+        return {"current_tokens": candidates["current_tokens"]}
+    parameters = signature.parameters
+    accepts_extra = any(
+        parameter.kind is inspect.Parameter.VAR_KEYWORD
+        for parameter in parameters.values()
+    )
+    return {
+        name: value
+        for name, value in candidates.items()
+        if accepts_extra or name in parameters
+    }
+
 logger = logging.getLogger(__name__)
 
