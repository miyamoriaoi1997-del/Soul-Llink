--- /dev/null
+++ b/tests/agent/test_pcltm_context_budget.py
@@ -0,0 +1,60 @@
+"""Tests for PCLTM context-engine single budget governance."""
+
+from importlib import import_module
+
+
+def _engine_class():
+    module = import_module("plugins.context_engine.pcltm-context")
+    return module.PCLTMContextCompressionEngine
+
+
+def test_pcltm_budget_tokens_sets_trigger_and_derived_buckets():
+    engine = _engine_class()()
+
+    engine.configure({"budget_tokens": 128_000})
+    engine.update_model(model="test-model", context_length=300_000)
+
+    assert engine.threshold_tokens == 128_000
+    assert engine.should_compress(127_999) is False
+    assert engine.should_compress(128_000) is True
+    assert engine._configured_budget_tokens == 128_000
+    assert engine._configured_message_budget_tokens == 89_600
+    assert engine._message_budget_tokens(current_tokens=140_000) == 89_600
+    assert engine.governance.active_frame_budget == 89_600
+    assert engine.governance.continuity_budget == 6_400
+    assert engine.governance.tool_evidence_budget == 6_400
+    assert engine.governance.recall_budget == 10_240
+    assert engine._request_budget_safety_margin_tokens == 3_840
+
+
+def test_pcltm_explicit_sub_budgets_override_budget_tokens_derivation():
+    engine = _engine_class()()
+
+    engine.configure(
+        {
+            "budget_tokens": 128_000,
+            "active_frame_budget_tokens": 64_000,
+            "continuity_budget_tokens": 4_000,
+            "tool_evidence_budget_tokens": 2_000,
+            "recall_budget_tokens": 3_000,
+            "request_budget_safety_margin_tokens": 8_000,
+        }
+    )
+    engine.update_model(model="test-model", context_length=300_000)
+
+    assert engine.threshold_tokens == 128_000
+    assert engine._configured_message_budget_tokens == 64_000
+    assert engine._message_budget_tokens(current_tokens=140_000) == 64_000
+    assert engine.governance.active_frame_budget == 64_000
+    assert engine.governance.continuity_budget == 4_000
+    assert engine.governance.tool_evidence_budget == 2_000
+    assert engine.governance.recall_budget == 3_000
