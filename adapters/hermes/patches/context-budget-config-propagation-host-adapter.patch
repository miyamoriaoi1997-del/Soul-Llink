diff --git a/tests/run_agent/test_plugin_context_engine_init.py b/tests/run_agent/test_plugin_context_engine_init.py
index 2c7e53e13..9d58982a3 100644
--- a/tests/run_agent/test_plugin_context_engine_init.py
