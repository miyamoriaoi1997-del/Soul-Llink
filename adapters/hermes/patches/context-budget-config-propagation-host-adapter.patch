@@ -37,6 +37,49 @@ class _ToolEngine(_StubEngine):
         ]
 
 
+class _ConfigurableEngine(_StubEngine):
+    def __init__(self):
+        self.events = []
+        self.config = None
+
+    def configure(self, config):
+        self.events.append("configure")
+        self.config = config
+
+    def update_model(self, **kwargs):
+        self.events.append("update_model")
+        super().update_model(**kwargs)
+
+
+def test_plugin_engine_gets_context_config_before_model_metadata():
+    """The selected plugin receives the authoritative context config first."""
+    engine = _ConfigurableEngine()
+    context_config = {"engine": "stub", "budget_tokens": 256_000}
+    cfg = {"context": context_config, "agent": {}}
+
+    with (
+        patch("hermes_cli.config.load_config", return_value=cfg),
+        patch("plugins.context_engine.load_context_engine", return_value=engine),
+        patch("agent.model_metadata.get_model_context_length", return_value=1_050_000),
+        patch("run_agent.get_tool_definitions", return_value=[]),
+        patch("run_agent.check_toolset_requirements", return_value={}),
+        patch("run_agent.OpenAI"),
+    ):
+        from run_agent import AIAgent
+
+        agent = AIAgent(
+            api_key="test-key-1234567890",
+            base_url="https://openrouter.ai/api/v1",
+            quiet_mode=True,
+            skip_context_files=True,
+            skip_memory=True,
+        )
+
+    assert agent.context_compressor is engine
+    assert engine.config is context_config
+    assert engine.events == ["configure", "update_model"]
+
+
 def test_plugin_engine_gets_context_length_on_init():
