+    def test_prefetch_forwards_session_identity(self):
+        """AST-level check: prefetch uses the same explicit session scope."""
+        import ast
+        import inspect
+        import textwrap
+        from agent.turn_context import build_turn_context as _btc
+
+        tree = ast.parse(textwrap.dedent(inspect.getsource(_btc)))
+        calls = [
+            node
+            for node in ast.walk(tree)
+            if isinstance(node, ast.Call)
+            and isinstance(node.func, ast.Attribute)
+            and node.func.attr == "prefetch_all"
+        ]
+        assert len(calls) == 1
+        forwarded = {keyword.arg: ast.unparse(keyword.value) for keyword in calls[0].keywords}
+        assert forwarded == {"session_id": "agent.session_id"}
