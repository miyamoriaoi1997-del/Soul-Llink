+    @staticmethod
+    def _merge_request_mappings(target: Dict[str, Any], source: Dict[str, Any]) -> None:
+        for key, value in source.items():
+            if isinstance(value, dict) and isinstance(target.get(key), dict):
+                MemoryManager._merge_request_mappings(target[key], value)
+            elif isinstance(value, dict):
+                nested: Dict[str, Any] = {}
+                MemoryManager._merge_request_mappings(nested, value)
+                target[key] = nested
+            else:
+                target[key] = value
+
+    def request_overrides(self) -> Dict[str, Any]:
+        """Merge request-scoped overrides from all providers.
+
+        Later providers win on scalar conflicts while nested mappings such as
+        ``extra_body.metadata`` are merged rather than replaced.
+        """
+        merged: Dict[str, Any] = {}
+        for provider in self._providers:
+            try:
+                value = provider.request_overrides()
+                if isinstance(value, dict):
+                    self._merge_request_mappings(merged, value)
+            except Exception as e:
+                logger.debug(
+                    "Memory provider '%s' request_overrides failed: %s",
+                    provider.name, e,
+                )
+        return merged
